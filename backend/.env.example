# Copia este archivo como .env para cambiar un valor. Todos son opcionales.
API_PORT=8080
# Donde esta la base: por defecto, la de ../database publicada en el host.
DB_HOST=host.docker.internal
DB_PORT=3307
DB_NAME=ensamblame
DB_USER=ensamblame
DB_PASSWORD=ensamblame_dev
# Origenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGEN=http://localhost:8081,http://localhost:5173
# Clave que firma los tokens JWT (minimo 32 caracteres). Cambiala fuera de desarrollo.
JWT_SECRET=clave-de-desarrollo-ensamblame-cambiar-en-produccion-0123456789
