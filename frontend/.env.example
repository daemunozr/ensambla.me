# Copia este archivo como .env para cambiar valores (opcional).
WEB_PORT=8081
# URL de la API (con /api/v1) tal como la ve el navegador. Al cambiarla hay que reconstruir la
# imagen: docker compose up -d --build. En desarrollo (npm run dev) se define en frontend/.env.local.
VITE_API_URL=http://localhost:8080/api/v1
